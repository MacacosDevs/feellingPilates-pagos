PORT=8081

# Misma base de datos Postgres que el backend principal, schema "pagos".
DATABASE_URL=postgresql://feelingpilates:feelingpilates@localhost:5432/FeelingPilates?schema=pagos

# Debe ser EXACTAMENTE el mismo valor que app.jwt.secreto / JWT_SECRETO en el
# backend principal (feellingPilates), o los tokens que emite no van a validar
# aqui. Firmado con HS256, minimo 32 bytes.
JWT_SECRETO=cambia-este-secreto-en-produccion-minimo-32-bytes!

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Igual que app.pagos.compra-pendiente-expira-minutos en el backend principal.
COMPRA_PENDIENTE_EXPIRA_MINUTOS=60

CORS_ORIGENES_PERMITIDOS=http://localhost:5173

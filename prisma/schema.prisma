generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pagos"]
}

// Catalogo de precios. `categoria` (pilates / bacu_fit / combo) es el modelo
// original; los paquetes nuevos de caja la dejan en null y declaran su
// composicion por actividad en PaqueteActividad.
model Paquete {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria      String?  @db.VarChar(20)
  nombre         String   @db.VarChar(100)
  descripcion    String?  @db.VarChar(255)
  precioCentavos Int      @map("precio_centavos")
  vigenciaDias   Int      @map("vigencia_dias")
  unitarioTexto  String?  @map("unitario_texto") @db.VarChar(50)
  destacado      Boolean  @default(false)
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  compras     Compra[]
  actividades PaqueteActividad[]

  @@map("paquete")
  @@schema("pagos")
}

// Cuantas clases de cada actividad incluye un paquete. tipoActividadId apunta
// a tipo_actividad.id en el schema "public" (catalogo del backend principal);
// igual que usuarioId en Compra, la FK vive solo en el SQL de migracion.
model PaqueteActividad {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paqueteId       String   @map("paquete_id") @db.Uuid
  tipoActividadId String   @map("tipo_actividad_id") @db.Uuid
  cantidadClases  Int      @map("cantidad_clases")
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)

  @@unique([paqueteId, tipoActividadId])
  @@map("paquete_actividad")
  @@schema("pagos")
}

// usuarioId apunta a usuario.id en el schema "public" del backend principal.
// No se modela como relacion de Prisma (ese schema no es propiedad de este
// servicio); el constraint de FK cross-schema vive solo en el SQL de
// migracion, no aqui.
model Compra {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId             String    @map("usuario_id") @db.Uuid
  paqueteId             String    @map("paquete_id") @db.Uuid
  montoCentavos         Int       @map("monto_centavos")
  moneda                String    @default("mxn") @db.VarChar(3)
  estado                String    @default("pendiente") @db.VarChar(20)
  stripePaymentIntentId String?   @map("stripe_payment_intent_id") @db.VarChar(100)
  idempotencyKey        String?   @map("idempotency_key") @db.VarChar(100)
  fechaExpiracion       DateTime? @map("fecha_expiracion") @db.Timestamptz
  creadoEn              DateTime  @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn         DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  // Detalle del Charge de Stripe, guardado cuando el pago se confirma
  // (payment_intent.succeeded). Todo nullable porque no existe hasta entonces.
  tarjetaMarca          String?   @map("tarjeta_marca") @db.VarChar(20)
  tarjetaUltimosDigitos String?   @map("tarjeta_ultimos_digitos") @db.VarChar(4)
  reciboUrl             String?   @map("recibo_url") @db.VarChar(500)
  // Comision de Stripe y lo que realmente se recibe, en centavos (del
  // balance_transaction del Charge).
  montoComisionCentavos Int?      @map("monto_comision_centavos")
  montoNetoCentavos     Int?      @map("monto_neto_centavos")
  // Nivel de riesgo de Radar en el momento del cargo: normal/elevated/highest/
  // not_assessed/unknown.
  riesgoNivel           String?   @map("riesgo_nivel") @db.VarChar(20)
  // Motivo del ultimo rechazo (payment_intent.payment_failed), para mostrarle
  // al cliente por que fallo, no solo que fallo.
  ultimoErrorCodigo     String?   @map("ultimo_error_codigo") @db.VarChar(100)
  ultimoErrorMensaje    String?   @map("ultimo_error_mensaje") @db.VarChar(500)

  // Venta presencial en caja. metodoPago: stripe | efectivo | transferencia.
  // registradaPorId (quien cobro) y salonId (sede) apuntan a public.usuario y
  // public.salon; null en compras por Stripe desde la app. Un mismo ticket de
  // caja agrupa sus lineas por grupoCompraId y las numera con numeroItem.
  metodoPago            String    @default("stripe") @map("metodo_pago") @db.VarChar(20)
  registradaPorId       String?   @map("registrada_por_id") @db.Uuid
  salonId               String?   @map("salon_id") @db.Uuid
  grupoCompraId         String?   @map("grupo_compra_id") @db.Uuid
  numeroItem            Int?      @map("numero_item")
  // Por que una venta de caja se cancelo o se marco como reembolsada.
  motivoEstado          String?   @map("motivo_estado")

  paquete Paquete @relation(fields: [paqueteId], references: [id])

  @@index([usuarioId])
  @@index([grupoCompraId], map: "idx_compra_grupo")
  @@index([stripePaymentIntentId])
  @@index([idempotencyKey])
  @@map("compra")
  @@schema("pagos")
}
